{
  "manifest_version": 3,
  "name": "Roots · Tree and Translate",
  "description": "Capture visible X knowledge into the desktop Roots Tree, exchange it with bound Mesh peers, and translate with local PLaMo.",
  "version": "0.4.5",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "tree-capture.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Roots Translate"
  },
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
