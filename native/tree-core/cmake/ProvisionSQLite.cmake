# Shared Android build dependency provisioner (CMake 3.22+).
# Pin the official release and publisher's SHA3-256, not a mutable latest URL.
function(roots_provision_sqlite out)
    set(version "3540100")
    set(digest "92281c86e2957f9b9305890f9ac04204caa7b677cc868dc326d942689df28e30")
    set(url "https://sqlite.org/2026/sqlite-amalgamation-${version}.zip")
    get_filename_component(cache "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../android/.roots-deps" ABSOLUTE)
    file(MAKE_DIRECTORY "${cache}")
    # Gradle may configure debug/release or multiple variants concurrently.
    file(LOCK "${cache}/sqlite.lock" GUARD FUNCTION TIMEOUT 300)
    set(archive "${cache}/sqlite-amalgamation-${version}.zip")
    set(source "${cache}/sqlite-amalgamation-${version}")
    set(valid FALSE)
    if(EXISTS "${archive}")
        file(SHA3_256 "${archive}" actual)
        if(actual STREQUAL digest)
            set(valid TRUE)
        endif()
    endif()
    if(NOT valid)
        message(STATUS "Roots SQLite: downloading pinned version 3.54.1")
        file(REMOVE "${archive}.partial")
        file(DOWNLOAD "${url}" "${archive}.partial"
            TLS_VERIFY ON EXPECTED_HASH "SHA3_256=${digest}"
            TIMEOUT 180 INACTIVITY_TIMEOUT 30 SHOW_PROGRESS)
        file(RENAME "${archive}.partial" "${archive}")
        # Invalidate extracted sources after replacing an invalid archive.
        file(REMOVE_RECURSE "${source}")
    endif()
    if(NOT EXISTS "${source}/sqlite3.c" OR NOT EXISTS "${source}/sqlite3.h")
        set(stage "${cache}/sqlite-extract-${version}")
        file(REMOVE_RECURSE "${stage}")
        file(MAKE_DIRECTORY "${stage}")
        file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${stage}")
        if(NOT EXISTS "${stage}/sqlite-amalgamation-${version}/sqlite3.c" OR
           NOT EXISTS "${stage}/sqlite-amalgamation-${version}/sqlite3.h")
            message(FATAL_ERROR "Verified SQLite archive has unexpected layout")
        endif()
        file(REMOVE_RECURSE "${source}")
        file(RENAME "${stage}/sqlite-amalgamation-${version}" "${source}")
        file(REMOVE_RECURSE "${stage}")
    endif()
    message(STATUS "Roots SQLite: using verified archive and cached source at ${source}")
    set(${out} "${source}" PARENT_SCOPE)
endfunction()
