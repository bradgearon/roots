<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- REP/1 is optional; Roots still installs on devices without BLE. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <application>
        <activity android:name="com.wds.sixstars.contextoverlay.EncounterActivity" android:exported="false" android:label="Roots Encounters" android:theme="@style/RootsTheme" />
        <service android:name="com.wds.sixstars.contextoverlay.EncounterService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <activity android:name="com.wds.sixstars.contextoverlay.MeshActivity" android:exported="true" android:label="Roots Mesh" android:theme="@style/RootsTheme" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="roots" android:host="mesh" android:path="/v1"/>
            </intent-filter>
        </activity>
        <activity android:name="com.wds.sixstars.contextoverlay.InferenceHistoryActivity" android:exported="false" android:label="Inference history" android:theme="@style/RootsTheme" />
        <activity android:name="com.wds.sixstars.contextoverlay.PoeticMovementActivity" android:exported="false" android:label="Poetic Movement" android:theme="@style/RootsTheme" />
        <activity android:name="com.wds.sixstars.contextoverlay.RootsStreamActivity" android:exported="false" android:label="Roots" android:theme="@style/RootsTheme" />
        <activity android:name="com.wds.sixstars.contextoverlay.tree.TreeActivity" android:exported="false" android:label="Tree of Life" android:theme="@style/RootsTheme" />
        <activity
            android:name="com.wds.sixstars.contextoverlay.OverlayTranslationSettingsActivity"
            android:exported="false"
            android:label="@string/context_overlay_title"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <service
            android:name="com.wds.sixstars.contextoverlay.XTranslationAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/context_overlay_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/context_overlay_accessibility_config" />
        </service>
    </application>
</manifest>
