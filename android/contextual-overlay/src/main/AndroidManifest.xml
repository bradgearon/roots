<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application>
        <activity android:name="com.wds.sixstars.contextoverlay.InferenceHistoryActivity" android:exported="false" android:label="Inference history" android:theme="@style/RootsTheme" />
        <activity android:name="com.wds.sixstars.contextoverlay.PoeticMovementActivity" android:exported="false" android:label="Poetic Movement" android:theme="@style/RootsTheme" />
        <activity android:name="com.wds.sixstars.contextoverlay.RootsStreamActivity" android:exported="false" android:label="Roots" android:theme="@style/RootsTheme" />
        <activity android:name="com.wds.sixstars.contextoverlay.tree.TreeActivity" android:exported="false" android:label="Tree of Life" android:theme="@style/RootsTheme" />
        <activity
            android:name="com.wds.sixstars.contextoverlay.OverlayTranslationSettingsActivity"
            android:exported="false"
            android:label="@string/context_overlay_title"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <service
            android:name="com.wds.sixstars.contextoverlay.XTranslationAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/context_overlay_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/context_overlay_accessibility_config" />
        </service>
    </application>
</manifest>
